# =============================================
# Environment Variables Example
# =============================================
# 
# Copy this file to .env.local (for local development) or .env (for production)
# and fill in the actual values.
#
# DO NOT commit .env or .env.local files to version control!
# They contain sensitive information and should remain private.

# =============================================
# Site Configuration
# =============================================

# The base URL of your website (used for SEO, sitemap, canonical URLs, etc.)
# 
# Primary domain (production):
NEXT_PUBLIC_SITE_URL=https://glaum.ca
#
# Alternative subdomain (may be used during production):
# NEXT_PUBLIC_SITE_URL=https://glaum.terrainfinity.ca
#
# Local development:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Note: Set this to the PRIMARY domain (glaum.ca) for canonical URLs and SEO,
# even if the site is temporarily accessed via glaum.terrainfinity.ca.
# This prevents duplicate content issues in search engines.

# =============================================
# Optional: Error Tracking (Future Use)
# =============================================
# Uncomment and configure if you want to use a custom error tracking service
# NEXT_PUBLIC_ERROR_TRACKING_ENDPOINT=https://your-error-tracking-service.com/api/errors

# =============================================
# Next.js Built-in Variables
# =============================================
# NODE_ENV is automatically set by Next.js:
#   - development when running npm run dev
#   - production when running npm run build or npm start
# You typically don't need to set this manually.
